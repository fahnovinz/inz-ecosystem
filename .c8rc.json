{
  "include": [
    "src/**/*.js",
    "bin/**/*.js"
  ],
  "exclude": [
    "test/**",
    "node_modules/**"
  ],
  "reporter": [
    "text",
    "text-summary",
    "lcov",
    "html"
  ],
  "report-dir": "coverage",
  "all": true,
  "check-coverage": true,
  "lines": 90,
  "functions": 90,
  "branches": 85,
  "statements": 90
}
